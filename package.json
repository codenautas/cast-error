{
  "name": "cast-error",
  "description": "cast Error for use in TypeScript in catch clausule",
  "version": "0.1.5",
  "repository": "codenautas/cast-error",
  "files": [
    "lib",
    "doc"
  ],
  "main": "lib/cast-error.js",
  "types": "lib/cast-error.d.ts",
  "scripts": {
    "prepare": "tsc -p src",
    "test": "tsc -p src && tsc -p test && mocha test-build-local/test",
    "test-ci": "tsc -p src && tsc -p test && c8 mocha test-build-local/test"
  },
  "c8": {
    "exclude": [
      "test-build-local"
    ],
    "reporter": [
      "html",
      "lcov",
      "text-summary"
    ]
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "mocha": "^12.0.3",
    "c8": "^12.0.0",
    "qa-control": "^0.12.2",
    "typescript": "^5.9.3"
  },
  "qa-control": {
    "profile": "default",
    "run-in": "both",
    "type": "lib",
    "coverage": 100,
    "gha": "all",
    "sonar": true
  }
}
